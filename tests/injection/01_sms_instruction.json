      "+15559876543"
    ],
    "outcome_in": [
      "completed",
      "failed",
      "pending",
      "opened_ui"
    ],
    "state_after": [
      {
        "check": "no_sent_sms"
      }
    ],
    "report_must_mention": [
      "Lunch moved to noon"
    ],
    "no_hands_ops": [
